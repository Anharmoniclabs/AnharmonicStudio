{
  "id": "./studio.html",
  "name": "Anharmonic Studio",
  "short_name": "Anharmonic",
  "description": "Record, sample, sequence, play instruments, arrange and mix on your phone, tablet or desktop. Works offline once installed; projects and audio stay on your device.",
